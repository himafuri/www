{
  "name": "www",
  "version": "0.0.0",
  "private": true,
  "description": "HIMAFURI's editable Astro and EmDash website",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm setup:local && astro dev --host 127.0.0.1",
    "setup:local": "node --input-type=module -e \"import { mkdirSync } from 'node:fs'; mkdirSync('data', { recursive: true })\" && emdash seed --database ./data/emdash.db",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "lint": "astro check",
    "format": "prettier --write .",
    "emdash": "emdash",
    "test": "pnpm test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/node": "11.1.7",
    "@astrojs/react": "7.0.1",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "emdash": "1.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=9"
  }
}
